/* Variáveis de Cores (Tema Claro por padrão) */
:root {
    --cor-fundo: #f4f6f8;
    --cor-post: #ffffff;
    --cor-texto: #1a202c;
    --cor-primaria: #0d1b2a;
    --cor-secundaria: #d4af37; /* Dourado */
    --cor-borda: #d4af37;
}

/* Configuração do Tema Escuro */
body.tema-escuro {
    --cor-fundo: #0d1b2a;
    --cor-post: #1b263b;
    --cor-texto: #f1f1f1;
    --cor-primaria: #1b263b;
}

/* Estilo específico para o botão quando o tema escuro estiver ativo */
.tema-escuro .btn-tema-escuro {
    background-color: var(--cor-secundaria);
    color: #0d1b2a;
    border-color: #ffffff;
}

/* Estilos Globais */
body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    transition: background-color 0.3s ease, color 0.3s ease;
}

/* Cabeçalho */
header {
    background: linear-gradient(135deg, var(--cor-primaria), #0d1b2a);
    color: var(--cor-secundaria);
    text-align: center;
    padding: 2.5rem 1rem;
    border-bottom: 3px solid var(--cor-secundaria);
    position: relative;
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
}

header p {
    font-size: 1.1rem;
    color: #e0e1dd;
}

/* Estilo do Botão de Troca de Tema */
.btn-tema-escuro {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: var(--cor-primaria);
    color: var(--cor-secundaria);
    border: 2px solid var(--cor-secundaria);
    padding: 10px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.btn-tema-escuro:hover {
    transform: scale(1.05);
}

/* Estrutura Principal */
.container {
    max-width: 900px;
    margin: 20px auto;
    padding: 0 20px;
}

/* Cartões de Postagem */
.post {
    background-color: var(--cor-post);
    border: 1px solid var(--cor-borda);
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.15);
    transition: background-color 0.3s ease;
}

.post h2 {
    color: var(--cor-secundaria);
    margin-top: 0;
}

/* Imagens do Blog */
.post img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--cor-borda);
    margin: 15px 0;
}

/* Detalhe de Folhas nos Marcadores */
ul {
    list-style: none;
    padding-left: 0;
}

ul li {
    padding-left: 28px;
    position: relative;
    margin-bottom: 10px;
}

ul li::before {
    content: "🍂";
    position: absolute;
    left: 0;
    top: 0;
}

/* Botão de Curtida da Plantinha */
.like-container {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px dashed rgba(212, 175, 55, 0.3);
    display: flex;
    align-items: center;
    gap: 12px;
}

.like-btn {
    background: transparent;
    border: 2px solid var(--cor-secundaria);
    color: var(--cor-secundaria);
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
}

.like-btn:hover {
    background-color: var(--cor-secundaria);
    color: #0d1b2a;
}

.like-btn:active {
    transform: scale(0.95);
}

.plant-icon {
    font-size: 1.4rem;
    transition: transform 0.2s ease;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 20px;
    border-top: 1px solid var(--cor-secundaria);
    color: #778da9;
    font-size: 0.9rem;
}
