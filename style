/* Estilos Globais e Cores (Azul Marinho e Dourado) */
body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #0d1b2a;
    color: #f1f1f1;
    line-height: 1.6;
}

/* Cabeçalho */
header {
    background: linear-gradient(135deg, #1b263b, #0d1b2a);
    color: #d4af37;
    text-align: center;
    padding: 2.5rem 1rem;
    border-bottom: 3px solid #d4af37;
}

header h1 {
    margin: 0;
    font-size: 2.5rem;
}

header p {
    font-size: 1.1rem;
    color: #e0e1dd;
}

/* Estrutura Principal */
.container {
    max-width: 900px;
    margin: 20px auto;
    padding: 0 20px;
}

/* Cartões de Postagem */
.post {
    background-color: #1b263b;
    border: 1px solid #d4af37;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.15);
}

.post h2 {
    color: #d4af37;
    margin-top: 0;
}

/* Imagens do Blog */
.post img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #d4af37;
    margin: 15px 0;
}

/* Detalhe de Folhas nos Marcadores */
ul {
    list-style: none;
    padding-left: 0;
}

ul li {
    padding-left: 28px;
    position: relative;
    margin-bottom: 10px;
}

ul li::before {
    content: "🍂";
    position: absolute;
    left: 0;
    top: 0;
}

/* Botão de Curtida da Plantinha */
.like-container {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px dashed rgba(212, 175, 55, 0.3);
    display: flex;
    align-items: center;
    gap: 12px;
}

.like-btn {
    background: transparent;
    border: 2px solid #d4af37;
    color: #d4af37;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
}

.like-btn:hover {
    background-color: #d4af37;
    color: #0d1b2a;
}

.like-btn:active {
    transform: scale(0.95);
}

.plant-icon {
    font-size: 1.4rem;
    transition: transform 0.2s ease;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 20px;
    border-top: 1px solid #d4af37;
    color: #778da9;
    font-size: 0.9rem;
}
